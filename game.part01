 for(let z of [145,490,775]){let x=W.center(z);for(let k=0;k<14;k++)box('speed hump',x-8.4+k*1.25,.11,z,1.2,.22,.65,k%2?yellow:black);sign('مطب','SPEED BUMP',x-10.3,2,z-10,2.3,1.25,'#9d5824');sign('هدى السرعة','SLOW DOWN',x+10.4,2.8,z-18,3,1.1,'#8c4528');}
