 let finish=box('Haram finish paint',W.center(970),.05,970,18,.03,8,teal);for(let i=0;i<18;i++)box('finish checker',W.center(970)-8.5+i,.07,969,1,.02,1,i%2?black:white);sign('موقف الهرم','HARAM SQUARE • FINAL STOP',W.center(975),5,975,10,2,'#15515a');
 W.traffic=[];
 function tuk(z,lane){let n=new B.TransformNode('tuk-tuk',scene),body=box('yellow tuk body',0,.65,0,1.25,.7,1.9,yellow,n);box('black tuk cabin',0,1.37,-.18,1.33,.72,1.45,black,n);box('tuk windscreen',0,1.4,.59,1.12,.5,.035,glass,n);box('roof trim',0,1.78,-.12,1.42,.13,1.6,black,n);box('tuk rear window',0,1.4,-.93,.85,.35,.02,glass,n);for(let x of [-.57,.57]){box('tuk bright trim',x,.8,-.98,.06,.5,.04,chrome,n);let wh=cyl('rear wheel',x,.33,-.5,.18,.52,black,n,24);wh.rotation.z=Math.PI/2;sphere('rear hub',x*1.05,.33,-.5,.23,chrome,n);}let wh=cyl('front wheel',0,.32,.77,.17,.52,black,n,24);wh.rotation.z=Math.PI/2;sphere('headlight',0,.96,.98,.24,white,n);for(let x of [-.5,.5])sphere('tail lamp',x,.8,-.98,.12,orange,n);n.position.set(W.center(z)+lane,0,z);shadow.addShadowCaster(body);W.traffic.push({root:n,z,lane,base:lane,speed:4+(z%5),yield:0});}
 for(let i=0;i<12;i++)tuk(115+i*75,[-3.3,0,4][i%3]);
 W.boats=[];for(let z of [120,420,720]){let n=new B.TransformNode('felucca',scene);n.position.set(75,0,z);let hull=B.MeshBuilder.CreateSphere('wooden Nile boat',{diameter:1,segments:16},scene);hull.scaling.set(2.2,.45,7);hull.parent=n;hull.material=trunk;line('mast',[[0,.2,0],[0,8,0]],.06,trunk,n);let sail=B.MeshBuilder.CreateRibbon('cream sail',{pathArray:[[new V(0,7.8,0),new V(0,.7,-4)],[new V(.02,1,3),new V(.02,.7,-4)]],sideOrientation:B.Mesh.DOUBLESIDE},scene);sail.material=white;sail.parent=n;W.boats.push(n);}
 // Merge structural masonry, curbs and shop details by material to keep the street efficient.
 for(let a of scene.meshes)if(a.parent&&a.parent.name==='palm')statics.push(a);
 W.chunks=[];
 for(let m of Object.values(mats)){let groups=new Map();for(let a of statics.filter(a=>a.material===m)){a.computeWorldMatrix(true);let z=a.getBoundingInfo().boundingBox.centerWorld.z,key=a.name==='sand foundation'?'foundation':Math.floor(z/100);if(!groups.has(key))groups.set(key,[]);groups.get(key).push(a);}for(let [key,list] of groups){if(list.length){let merged=list.length>1?B.Mesh.MergeMeshes(list,true,true,undefined,false,false):list[0];if(merged){merged.name='street '+m.name;merged.receiveShadows=true;merged.freezeWorldMatrix();if(key!=='foundation')W.chunks.push({mesh:merged,z:Number(key)*100+50});}}}}
 W.signs=scene.meshes.filter(a=>a.material&&a.material.name.startsWith('enamel '));
 return W;
};
})();
