(function(){
'use strict';
const B=BABYLON,V=B.Vector3,C=B.Color3;
window.GizaWorld={center:z=>Math.sin(z/180)*13+Math.sin(z/420)*18};
GizaWorld.create=function(scene,shadow){
 const W=GizaWorld, mats={}, statics=[];let serial=0;
 function mat(n,color,rough=1){let m=new B.StandardMaterial(n,scene);m.diffuseColor=C.FromHexString(color);m.specularColor=new C(1-rough,1-rough,1-rough);mats[n]=m;return m;}
 const asphalt=mat('asphalt','#555452'),sand=mat('desert limestone','#bba58b'),curb=mat('curb ivory','#ddd1ae'),black=mat('rubber and wrought iron','#202d30'),white=mat('warm white','#ece9d9'),teal=mat('Nile enamel','#17646a'),yellow=mat('taxi saffron','#eab541'),glass=mat('blue smoked glass','#2f5058',.7),chrome=mat('chrome','#aeb8ae',.25),leaf=mat('palm green','#476448'),trunk=mat('palm bark','#8c7154'),orange=mat('terracotta','#b47453');
 function noiseTex(name,base,kind){let t=new B.DynamicTexture(name,{width:512,height:512},scene,false),c=t.getContext();c.fillStyle=base;c.fillRect(0,0,512,512);let seed=773;let rnd=()=>{seed=(seed*1664525+1013904223)>>>0;return seed/4294967296;};for(let i=0;i<15000;i++){let x=rnd()*512,y=rnd()*512,v=rnd();c.fillStyle=v>.5?'rgba(255,255,240,.10)':'rgba(15,20,20,.13)';c.fillRect(x,y,1+rnd()*2,1+rnd()*2);}if(kind==='brick'){c.strokeStyle='#97816c';c.lineWidth=2;for(let y=0;y<512;y+=32){c.beginPath();c.moveTo(0,y);c.lineTo(512,y);c.stroke();for(let x=(y/32%2)*48;x<512;x+=96){c.beginPath();c.moveTo(x,y);c.lineTo(x,y+32);c.stroke();}}}if(kind==='tiles'){c.strokeStyle='#a59b85';for(let i=0;i<=512;i+=64){c.fillRect(i,0,2,512);c.fillRect(0,i,512,2);}}t.update();t.uScale=4;t.vScale=4;return t;}
 asphalt.diffuseTexture=noiseTex('fine asphalt','#77736c');sand.diffuseTexture=noiseTex('limestone grain','#b8a58e');curb.diffuseTexture=noiseTex('pavement tiles','#c6baa3','tiles');trunk.diffuseTexture=noiseTex('bark','#9a8060','brick');
 const facades=['#c2a78c','#cebaa2','#a79c8a','#c4b394','#b19f8e','#cfbba2'].map((c,i)=>{let m=mat('masonry '+i,c);m.diffuseTexture=noiseTex('masonry-'+i,c,'brick');return m;});
 function box(n,x,y,z,w,h,d,m,parent){let a=B.MeshBuilder.CreateBox(n,{width:w,height:h,depth:d},scene);a.position.set(x,y,z);a.material=m;if(parent)a.parent=parent;else statics.push(a);return a;}
 function cyl(n,x,y,z,h,d,m,parent,tess=20){let a=B.MeshBuilder.CreateCylinder(n,{height:h,diameter:d,tessellation:tess},scene);a.position.set(x,y,z);a.material=m;if(parent)a.parent=parent;else statics.push(a);return a;}
 function sphere(n,x,y,z,s,m,parent){let a=B.MeshBuilder.CreateSphere(n,{diameter:s,segments:16},scene);a.position.set(x,y,z);a.material=m;if(parent)a.parent=parent;else statics.push(a);return a;}
 function line(n,pts,r,m,parent){let a=B.MeshBuilder.CreateTube(n,{path:pts.map(p=>new V(...p)),radius:r,tessellation:6},scene);a.material=m;if(parent)a.parent=parent;else statics.push(a);return a;}
 function sign(text,sub,x,y,z,w=5,h=1.6,color='#15515a',angle=0,parent){let t=new B.DynamicTexture('sign '+text,{width:1024,height:256},scene,false),c=t.getContext();c.fillStyle=color;c.fillRect(0,0,1024,256);c.strokeStyle='#e8d8a9';c.lineWidth=8;c.strokeRect(10,10,1004,236);c.textAlign='center';c.fillStyle='#fff0cf';c.font='bold 100px Tahoma, Arial';c.fillText(text,512,126);c.font='34px Arial';c.fillText(sub,512,198);t.update();let m=new B.StandardMaterial('enamel '+text,scene);m.diffuseTexture=t;m.emissiveColor=new C(.12,.12,.1);m.specularColor=C.Black();m.backFaceCulling=false;let a=B.MeshBuilder.CreatePlane(text,{width:w,height:h,sideOrientation:B.Mesh.DOUBLESIDE},scene);a.position.set(x,y,z);a.rotation.y=angle;a.material=m;if(parent)a.parent=parent;return a;}
 W.box=box;W.mat=mat;W.sign=sign;W.line=line;W.mats=mats;
 box('sand foundation',20,-1.2,490,650,.5,1450,sand);
 // A continuous gently curving boulevard, broad enough for bus and traffic.
 for(let z=-60;z<1060;z+=10){let x=W.center(z),rot=Math.atan2(W.center(z+5)-W.center(z-5),10);let a=box('asphalt',x,-.05,z,19,.12,10.2,asphalt);a.rotation.y=rot;for(let s of [-1,1]){let p=box('tiled sidewalk',x+s*11,.12,z,3,.32,10.3,curb);p.rotation.y=rot;for(let k=0;k<5;k++)box('alternating curb',x+s*9.65,.22,z-4+k*2,.28,.38,1.95,k%2?white:black);}for(let lane of [-3.2,3.2]){let dash=box('worn lane paint',x+lane,.03,z,.12,.02,4,white);dash.rotation.y=rot;}box('edge paint',x-9,.04,z,.12,.02,10.1,yellow);box('edge paint',x+9,.04,z,.12,.02,10.1,yellow);}
 // Nile water is a shader, with no external normal map or texture.
 B.Effect.ShadersStore.nileVertexShader='precision highp float; attribute vec3 position; uniform mat4 worldViewProjection; varying vec3 p; void main(){p=position;gl_Position=worldViewProjection*vec4(position,1.);}';
 B.Effect.ShadersStore.nileFragmentShader='precision highp float; varying vec3 p; uniform float time; void main(){float r=sin(p.z*2.4+sin(p.x*.5)+time)*sin(p.x*3.-time*.7);float glint=pow(max(0.,sin(p.z*5.+p.x*1.4+time)),34.);vec3 c=mix(vec3(.06,.25,.28),vec3(.21,.46,.46),r*.24+.55);c+=glint*vec3(.48,.33,.16)*(.3+.7*max(0.,1.-abs(p.x-30.)/80.));gl_FragColor=vec4(c,1.);}';
 let wm=new B.ShaderMaterial('Nile ripples',scene,{vertex:'nile',fragment:'nile'},{attributes:['position'],uniforms:['worldViewProjection','time']});let bank=[],far=[];for(let z=-100;z<=1200;z+=10){bank.push(new V(W.center(z)+14.6,-.27,z));far.push(new V(300,-.27,z));}let water=B.MeshBuilder.CreateRibbon('Nile river',{pathArray:[bank,far],sideOrientation:B.Mesh.DOUBLESIDE},scene);water.material=wm;W.water=wm;
 for(let z=-50;z<1060;z+=8){let x=W.center(z)+14;box('river stone embankment',x,.25,z,1.1,1,8.1,sand);for(let dz of [-3,0,3]){cyl('railing post',x,.93,z+dz,1,.075,black);sphere('railing cap',x,1.45,z+dz,.13,chrome);}box('river railing',x,1.18,z,.08,.055,8.1,black);box('river railing',x,.72,z,.08,.055,8.1,black);}
 function palm(x,z,size=1){let y=0;let root=new B.TransformNode('palm',scene);root.position.set(x,0,z);root.scaling.setAll(size);line('curved trunk',[[0,0,0],[.15,2,0],[.27,4,.15],[.15,6,.28]],.19,trunk,root);for(let j=0;j<13;j++){let a=j*Math.PI*2/13,ux=Math.cos(a),uz=Math.sin(a),paths=[[],[]];for(let k=0;k<10;k++){let t=k/9,r=t*3.5,py=6+.7*Math.sin(t*3.2)-t*.9,w=Math.sin(t*Math.PI)*.40;paths[0].push(new V(ux*r-uz*w,py,uz*r+ux*w+.28));paths[1].push(new V(ux*r+uz*w,py,uz*r-ux*w+.28));}let f=B.MeshBuilder.CreateRibbon('arched palm frond',{pathArray:paths,sideOrientation:B.Mesh.DOUBLESIDE},scene);f.material=leaf;f.parent=root;for(let k=2;k<8;k++){let t=k/9,r=t*3.4,py=6+.7*Math.sin(t*3.2)-t*.9;for(let side of [-1,1])line('leaflets',[[ux*r,py,uz*r+.28],[ux*(r+.6)-uz*.55*side,py-.2,uz*(r+.6)+ux*.55*side+.28]],.018,leaf,root);}}for(let j=0;j<5;j++)sphere('dates',Math.sin(j)*.21,5.9,Math.cos(j)*.2,.22,trunk,root);}
 for(let z=-10;z<1030;z+=37){palm(W.center(z)+12.1,z,.85+(z%3)*.08);if(z%2)palm(W.center(z)-12.8,z+13,.9);}
 const shopNames=[['كشري الجيزة','GIZA KOSHARY'],['قهوة النيل','NILE COFFEE'],['بقالة الأمانة','EL AMANA MARKET'],['عصير قصب','FRESH SUGAR CANE'],['ميكانيكي','AUTO SERVICE'],['مخبز المنيب','MONEEB BAKERY']];
 for(let i=0;i<48;i++){let z=i*22-25,x=W.center(z)-20-(i%3)*1.8,h=8+(i*17%5)*2.7,w=11+(i%3)*2,d=16;let m=facades[i%facades.length];box('masonry apartment',x,h/2,z,w,h,d,m);box('roof cornice',x,h+.15,z,w+.4,.35,d+.35,curb);box('roof parapet',x+w/2,h+.65,z,.2,1,16,curb);box('shop fascia',x+w/2+.07,3,z,.16,.55,15.5,white);for(let f=4.5;f<h-1;f+=2.7){for(let dz of [-5,-1,3,6]){box('window recess',x+w/2+.09,f,z+dz,.12,1.45,1.5,black);box('wood shutters',x+w/2+.16,f,z+dz,.12,1.3,1.36,i%3?teal:orange);for(let sl=-.5;sl<=.5;sl+=.2)box('shutter slats',x+w/2+.23,f+sl,z+dz,.05,.035,1.4,black);box('window lintel',x+w/2+.2,f+.81,z+dz,.3,.1,1.7,curb);if(dz===-1||dz===6){box('balcony floor',x+w/2+.75,f-.82,z+dz,1.7,.14,2,curb);box('balcony rail',x+w/2+1.5,f-.35,z+dz,.05,.05,2,black);for(let k=0;k<7;k++)box('balcony spindle',x+w/2+1.5,f-.58,z+dz-.9+k*.3,.045,.5,.045,black);}if(dz===3){box('AC unit',x+w/2+.4,f-.8,z+dz,.6,.55,.9,white);for(let k=0;k<5;k++)box('AC louver',x+w/2+.72,f-.98+k*.08,z+dz,.035,.025,.75,black);}}}
 for(let dz of [-4,3]){box('shop glazed door',x+w/2+.12,1.3,z+dz,.15,2.4,3.8,glass);for(let k=0;k<4;k++)box('door mullion',x+w/2+.22,1.3,z+dz-1.8+k*1.2,.06,2.4,.05,chrome);box('striped shop canopy',x+w/2+1,2.8,z+dz,2,.16,4.8,i%2?orange:teal);for(let k=0;k<6;k++)box('canopy cream stripe',x+w/2+1,2.9,z+dz-2+k*.8,2,.025,.24,curb);let ss=shopNames[(i+(dz===3?2:0))%6];sign(ss[0],ss[1],x+w/2+.24,3.6,z+dz,4.8,.9,i%2?'#923e27':'#175c61',-Math.PI/2);}
 if(i%4===0){box('rooftop tank base',x,h+.5,z,2.5,.4,2.5,curb);cyl('water tank',x,h+1.6,z,2,1.8,teal);}
 }
 // Distant city layers and unmistakable desert silhouettes.
 for(let i=0;i<45;i++){let z=i*35,x=-65-(i%7)*9,h=14+i%6*4;box('distant apartment skyline',x,h/2,z,14,h,19,facades[i%6]);}
 for(let i=0;i<3;i++){let p=B.MeshBuilder.CreateCylinder('Pyramid of Giza',{diameterTop:0,diameterBottom:140-i*26,height:85-i*16,tessellation:4},scene);p.position.set(-165-i*70,35-i*9,920+i*38);p.rotation.y=Math.PI/4;p.material=sand;}
 for(let z=0;z<1040;z+=60){let x=W.center(z)-10.6;cyl('street lamp pole',x,4.5,z,9,.11,black);line('lamp curved arm',[[x,8.8,z],[x+.15,9.2,z],[x+1.8,9.2,z]],.075,black);let light=box('lamp',x+1.8,9.1,z,.8,.13,.45,white);}
